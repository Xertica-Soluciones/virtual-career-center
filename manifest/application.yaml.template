apiVersion: app.k8s.io/v1beta1
kind: Application
metadata:
  name: "$name"
  namespace: "$namespace"
  annotations:
    kubernetes-engine.cloud.google.com/icon: >-
      data:image/png;base64,
    marketplace.cloud.google.com/deploy-info: '{
      "partner_id": "xertica-vcc-public",
      "product_id": "xertica-vcc-public.endpoints.xertica-vcc-public.cloud.goog",
      "partner_name": "Xertica"
    }'
  labels:
    app.kubernetes.io/name: "$name"
spec:
  descriptor:
    type: "vcc"
    version: "1.0.0"
    description: >-
      The Xertica Virtual Career Center is a cloud-based platform that uses Generative AI, Machine Learning, 
      and Natural Language Processing to improve student employability through:

      - Automatic resume generation  
      - Intelligent job-candidate and candidate-job matching  
      - Strategic insights into the local job market  

      # Support
      For assistance with deployment or troubleshooting, please contact Xertica support.  
      Support inquiries should include:  
      - **Google Cloud Project ID**  
      - **Description of the issue** (steps to reproduce, screenshots, or logs)  
      - **Contact information** (name, email, and phone number)  

      Support is available via:  
      - **Email**: [vcc-suporte@xertica.com](mailto:vcc-suporte@xertica.com)  
      - **Support Portal**: [https://www.xertica.ai/en/contact](https://www.xertica.ai/en/contact)
    maintainers:
      - name: Xertica Support Team
        url: https://www.xertica.ai
    links:
      - description: 'User Guide: Xertica Virtual Deployment'
        url: https://github.com/Xertica/virtual-career-center
      - description: 'Xertica Support Page'
        url: https://www.xertica.ai/en/contact
    notes: |-
      # Access Your Xertica Virtual Career Center

      ## Retrieve Service Endpoint
      If a public service is enabled, get the external IP address of your application:  

      ```shell
      kubectl get service vcc-frontend-service --namespace {{ .Release.Namespace }} \
        --output jsonpath='{.status.loadBalancer.ingress[0].ip}'
      ```

      Access the platform using the following URL:  
      ```
      http://<EXTERNAL-IP>
      ```

      ## Port Forwarding for Local Access
      If the service is private (ClusterIP-only), forward the application port to your local machine:

      ```shell
      kubectl port-forward \
        --namespace {{ .Release.Namespace }} \
        svc/vcc-frontend-service \
        8080:80
      ```

      Then access the application via:  
      [http://localhost:8080](http://localhost:8080)

      # Uninstallation Instructions
      To uninstall the application and its resources, run the following commands:

      ```shell
      kubectl delete -f k8s/deployment.yaml -n {{ .Release.Namespace }}
      kubectl delete -f k8s/service.yaml -n {{ .Release.Namespace }}
      ```

      Optionally, delete the namespace to clean up all related resources:

      ```shell
      kubectl delete namespace {{ .Release.Namespace }}
      ```
  selector:
    matchLabels:
      app.kubernetes.io/name: "$name"
  componentKinds:
    - group: apps
      kind: Deployment
    - group: ""
      kind: Service
